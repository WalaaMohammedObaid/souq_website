@model ProductVm


      <form asp-action="Create" asp-controller="Product" method="post" class="myform" data-aos="fade-up" data-aos-delay="200">
          <div asp-validation-summary="None" class="text-danger"></div>
                    
         <div class="row">
           <div class="col-md-6">
               <input type="text" name="CategoryName" id="CategoryName" class="form-control" placeholder="اسم القسم">
                   <span asp-validation-for="CategoryName" class="text-danger"></span>
           </div>
                       
           <div class="col-md-6 ">
                <input type="text" class="form-control" name="ProductName" id="ProductName" placeholder="اسم المنتج" >
                    <span asp-validation-for="ProductName" class="text-danger"></span>
           </div>

           <div class="col-6">
                <input type="number" class="form-control" name="ProductPrice" id="ProductPrice" placeholder="سعر المنتج" >
                    <span asp-validation-for="ProductPrice" class="text-danger"></span>
           </div>

           <div class="col-6">
                <input type="number" class="form-control" name="ProductQty" id="ProductQty" placeholder="كمية المنتج" >
                    <span asp-validation-for="ProductQty" class="text-danger"></span>
           </div>
            
           <div class="col-12 text-center">
                 <input type="submit" class="btn btn-primary" value="ارسال"/>
           </div>

         </div>
      </form>
            